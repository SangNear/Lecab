// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ReviewResult {
  again
  easy
}

enum CefrLevel {
  A1
  A2
  B1
  B2
  C1
  C2
}

model User {
  id        String   @id @default(uuid())
  name      String?
  email     String   @unique
  password  String
  avatarUrl String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  words    Word[]
  sessions Session[]
  reviews  ReviewLog[]

  @@map("users")
}

model Category {
  id          String   @id @default(uuid())
  name        String   @default("")
  description String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  iconSlug    String   @default("library")
  words       Word[]

  @@unique([name])
  @@index([name])
  @@map("categories")
}

model Word {
  id            String   @id @default(uuid())
  userId        String
  partsofSpeech String   @default("noun")
  word          String
  meaning       String
  example       String[]
  pronunciation String?
  collocations  String[] @default([])
  synonyms      String[] @default([])
  categoryId    String

  // 📊 Tracking
  correctCount Int @default(0)
  wrongCount   Int @default(0)

  easinessFactor Float @default(2.5)
  intervalDays   Int   @default(0)

  // 🎨 UI / trạng thái

  isFavorite   Boolean @default(false)
  isRemembered Boolean @default(false)

  level          Int       @default(0) // mức độ nhớ
  lastReviewedAt DateTime?
  nextReviewDate DateTime  @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  reviews ReviewLog[]

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([userId, word, categoryId])
  @@index([userId, nextReviewDate])
  @@map("words")
}

model ReviewLog {
  id             String       @id @default(uuid())
  userId         String
  wordId         String
  result         ReviewResult
  intervalDays   Int
  nextReviewDate DateTime
  reviewdAt      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  word Word @relation(fields: [wordId], references: [id], onDelete: Cascade)

  @@index([userId, reviewdAt])
  @@map("reviews")
}

model Session {
  id           String   @id @default(uuid())
  userId       String
  refreshToken String   @unique
  isRevoked    Boolean  @default(false)
  deviceInfo   String?
  expiresAt    DateTime
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("sessions")
}
